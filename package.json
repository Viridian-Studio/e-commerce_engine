{
  "name": "e-commerce-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Headless, multi-store e-commerce engine with NestJS API and Angular admin panel.",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "start:api": "npm run start --workspace @ecom/api",
    "start:api:dev": "npm run start:dev --workspace @ecom/api",
    "start:admin": "npm run start --workspace @ecom/admin",
    "build:api": "npm run build --workspace @ecom/api",
    "build:admin": "npm run build --workspace @ecom/admin",
    "seed": "npm run seed --workspace @ecom/api",
    "test:api": "npm run test --workspace @ecom/api"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@nx/angular": "^23.2.0",
    "@nx/devkit": "^23.2.0",
    "@nx/eslint": "^23.2.0",
    "@nx/jest": "^23.2.0",
    "@nx/js": "^23.2.0",
    "@nx/web": "^23.2.0",
    "nx": "^23.2.0",
    "prettier": "^3.9.6"
  },
  "dependencies": {
    "@nx/nx-darwin-arm64": "^23.2.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@scarf/scarf@1.4.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "nx@23.2.0": true,
    "unrs-resolver@1.12.2": true
  }
}

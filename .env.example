# ===== E-Commerce Engine environment =====
# Copy to .env and adjust. Used by apps/api.

# Server
NODE_ENV=development
PORT=3000
API_PREFIX=api

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce_engine

# Auth / JWT
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:4200

# Seed
SEED_ADMIN_EMAIL=admin@ecommerce.engine
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=Engine Admin
